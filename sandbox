#!/usr/bin/env bash
set -e

CONTAINER_NAME="dotfiles-sandbox"
HOST_PORT=8833
IMAGE="lscr.io/linuxserver/webtop:alpine-mate"
DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exists() {
  docker ps -a --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"
}

running() {
  docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"
}

if exists; then
  if running; then
    echo "Sandbox already running: http://localhost:${HOST_PORT}"
  else
    echo "Starting existing sandbox..."
    docker start "$CONTAINER_NAME"
    echo "Sandbox running: http://localhost:${HOST_PORT}"
  fi
  exit 0
fi

echo "Creating sandbox container..."
docker run -d \
  --name "$CONTAINER_NAME" \
  -e PUID=1000 \
  -e PGID=1000 \
  -e TZ=UTC \
  -p "${HOST_PORT}:3000" \
  -v "${DOTFILES_DIR}:/dotfiles:ro" \
  --shm-size="1gb" \
  "$IMAGE"

echo "Waiting for container to initialize..."
# The LinuxServer image provisions the 'abc' user, its wheel-group membership,
# and sudoers via s6 init *after* the container starts (not just apk, which is
# baked into the image layer and present instantly). While it does so it briefly
# flaps — abc exists but can't yet sudo. Require several consecutive successful
# sudo checks so we clear that window before the setup below, which relies on
# passwordless sudo throughout. s6 init runs once at startup, so it won't reopen
# the window during the long setup that follows.
ready=0
until [ "$ready" -ge 3 ]; do
  if docker exec -u abc "$CONTAINER_NAME" sudo -n true >/dev/null 2>&1; then
    ready=$((ready + 1))
  else
    ready=0
  fi
  sleep 1
done

echo "Linking dotfiles and running tools tier setup (this takes a few minutes)..."
# Run the root setup.sh (not alpine/setup.sh directly) so the sandbox gets the
# dotfile symlinks — zsh/p10k/git aliases/etc. — before dispatching to the
# Alpine tier install. Symlinks land in the writable $HOME and point at the
# read-only /dotfiles mount, so the RO mount is fine. TIER is the positional arg.
docker exec \
  -u abc \
  "$CONTAINER_NAME" \
  bash /dotfiles/setup.sh tools

echo "Sandbox ready: http://localhost:${HOST_PORT}"
